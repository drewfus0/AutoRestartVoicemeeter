<Window x:Class="AutoRestartVoicemeeter.UI.DeviceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target Device Selection — AutoRestart VoiceMeeter"
        Height="620" Width="720"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#121215" Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Custom ScrollBar & Item Styles -->
        <SolidColorBrush x:Key="SelectedBg" Color="#042F2E"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#10B981"/>
        <SolidColorBrush x:Key="UnselectedBg" Color="#1E1E24"/>
        <SolidColorBrush x:Key="UnselectedBorder" Color="#27272A"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🎧 Target Device Selection" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Select which USB devices or Audio Endpoints will trigger VoiceMeeter engine restart upon connection."
                       Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
        </StackPanel>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="#18181B" CornerRadius="6" Padding="8,4" Margin="0,0,0,10" BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="4,0,8,0" FontSize="14" Foreground="#9CA3AF"/>
                <TextBox x:Name="SearchTextBox" Grid.Column="1" Background="Transparent" Foreground="#F4F4F5"
                         BorderThickness="0" Padding="4" VerticalAlignment="Center" FontSize="13"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Search devices by friendly name or device code..."/>
                <TextBlock x:Name="SearchPlaceholderText" Grid.Column="1" Text="Search devices by name or code..."
                           Foreground="#6B7280" VerticalAlignment="Center" IsHitTestVisible="False" Margin="6,0,0,0" FontSize="13"/>
                <Button Grid.Column="2" Content="✖" Click="ClearSearch_Click" Background="Transparent" Foreground="#9CA3AF"
                        BorderThickness="0" Padding="6,2" Cursor="Hand" ToolTip="Clear search filter" x:Name="ClearSearchButton" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Discovered Devices List -->
        <Border Grid.Row="2" Background="#18181B" CornerRadius="8" Padding="4" BorderBrush="#27272A" BorderThickness="1">
            <ListView x:Name="DeviceListView" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="2,3"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" CornerRadius="6" Padding="12,10" BorderThickness="2"
                                Background="#1E1E24" BorderBrush="#27272A" Margin="0,2" Cursor="Hand"
                                MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selection CheckBox -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                          Grid.Column="0" Margin="0,0,14,0" Cursor="Hand">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>

                                <!-- Info Stack -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F4F4F5" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CodeText" Text="{Binding DeviceCode}" Foreground="#9CA3AF" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Badges -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Border x:Name="StatusBadge" Background="#065F46" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                                        <TextBlock Text="✓ ACTIVE TARGET" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#27272A" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding Type}" Foreground="#D4D4D8" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Dynamic Visual Highlighting Trigger -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#042F2E"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="NameText" Property="Foreground" Value="#34D399"/>
                                <Setter TargetName="NameText" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="StatusBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Custom Keyword / Device Code Entry -->
        <Border Grid.Row="3" Background="#18181B" CornerRadius="6" Padding="12" Margin="0,10,0,10" BorderBrush="#27272A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Add Custom Device Code / Pattern:" Foreground="#D4D4D8" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="CustomCodeTextBox" Background="#121215" Foreground="#FFFFFF" BorderBrush="#3F3F46"
                             Padding="8,6" Margin="0,4,0,0" FontSize="12" FontFamily="Consolas"
                             ToolTip="e.g. VID_04D8&amp;PID_EEAC or Qudelix"/>
                </StackPanel>
                <Button Grid.Column="1" Content="➕ Add Pattern" Click="AddCustomCode_Click"
                        Background="#0EA5E9" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" VerticalAlignment="Bottom"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Button Content="🔄 Refresh Devices" Click="Refresh_Click" HorizontalAlignment="Left"
                    Background="#27272A" Foreground="#FFFFFF" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Apply" Click="Save_Click"
                        Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" Padding="18,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Cancel" Click="Cancel_Click"
                        Background="#27272A" Foreground="#FFFFFF" Padding="16,8" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
