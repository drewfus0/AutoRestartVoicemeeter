<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AutoRestartVoicemeeter</AssemblyName>
    <RootNamespace>AutoRestartVoicemeeter</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Company>AutoRestartVoicemeeter</Company>
    <Description>Silent system tray app that monitors Qudelix-5K connections and auto-restarts the VoiceMeeter audio engine.</Description>
    <!-- Self-contained is false; .NET 8 runtime ships with Windows 11 -->
    <SelfContained>false</SelfContained>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
